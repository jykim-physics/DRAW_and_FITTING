universe             = vanilla
getenv               = true
executable           = python3_plus.sh
output               = log/job_summary_$(Cluster)_$(Process).out
error                = log/job_summary_$(Cluster)_$(Process).error
log                  = log/job_summary_$(Cluster)_$(Process).log

arguments            = $(script)
transfer_input_files = $(script)
request_cpus         = $(cpus)
request_memory       = $(mem)
queue script, cpus, mem from (
  etapip_gg_offset_novo_CB.py         14 28000
  #etapip_pipipi_offset_novo_CB.py     14 28000
  #etapip_gg_K_offset_CB.py             2  4000
  #etapip_pipipi_K_offset_CB.py         2  4000
)
